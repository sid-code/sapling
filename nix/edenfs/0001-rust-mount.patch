+//! edenfsctl mount
+//!
+//! A small native replacement for the Python `edenfsctl mount`: register a
+//! checkout with the daemon and ask it to mount.  It takes an existing
+//! Sapling/Mercurial repository (a directory containing `.hg`) and a mount
+//! point, writes the per-client `config.toml` the daemon reads, and issues
+//! the `mount` thrift call.
+
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Command;
+
+use anyhow::Context;
+use anyhow::Result;
+use async_trait::async_trait;
+use clap::Parser;
+
+use crate::ExitCode;
+use crate::Subcommand;
+use crate::get_edenfs_instance;
+
+#[derive(Parser, Debug)]
+#[clap(
+    name = "mount",
+    about = "Mount a Sapling/Mercurial checkout with EdenFS"
+)]
+pub struct MountCmd {
+    /// The mount point. Created if it does not exist; it must be empty.
+    #[clap(value_name = "MOUNT_POINT")]
+    mount_point: PathBuf,
+
+    /// The backing repository (a directory containing `.hg` or `.sl`).
+    /// Defaults to the mount point itself.
+    #[clap(long, value_name = "PATH")]
+    repo: Option<PathBuf>,
+
+    /// Mount read-only.
+    #[clap(long)]
+    read_only: bool,
+
+    /// The commit to check out.  Defaults to the repository's current parent
+    /// (queried from `sl`/`hg`).
+    #[clap(long, value_name = "COMMIT")]
+    rev: Option<String>,
+}
+
+#[async_trait]
+impl Subcommand for MountCmd {
+    async fn run(&self) -> Result<ExitCode> {
+        let instance = get_edenfs_instance();
+
+        // The daemon expects an absolute mount point.
+        fs::create_dir_all(&self.mount_point).with_context(|| {
+            format!(
+                "failed to create mount point {}",
+                self.mount_point.display()
+            )
+        })?;
+        let mount_point = self.mount_point.canonicalize().with_context(|| {
+            format!(
+                "failed to canonicalize mount point {}",
+                self.mount_point.display()
+            )
+        })?;
+
+        let repo = match &self.repo {
+            Some(repo) => repo.canonicalize().with_context(|| {
+                format!("failed to canonicalize repository {}", repo.display())
+            })?,
+            None => mount_point.clone(),
+        };
+        if !repo.join(".hg").is_dir() && !repo.join(".sl").is_dir() {
+            anyhow::bail!(
+                "{} is not a Sapling/Mercurial repository (no .hg or .sl directory); pass --repo",
+                repo.display()
+            );
+        }
+        if mount_point == repo {
+            anyhow::bail!(
+                "the mount point must differ from the backing repository ({})",
+                repo.display()
+            );
+        }
+
+        // The client name also names the directory under ~/.eden/clients.
+        let client_name = mount_point
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .context("mount point has no file name")?;
+        let client_dir = instance.config_directory(&client_name);
+        fs::create_dir_all(&client_dir)
+            .with_context(|| format!("failed to create {}", client_dir.display()))?;
+
+        // Record the mount point in ~/.eden/config.json so the daemon (and
+        // later edenfsctl invocations) can resolve it to the client name.
+        if !instance
+            .get_configured_mounts_map()?
+            .contains_key(&mount_point)
+        {
+            instance
+                .add_path_to_directory_map(&mount_point, &client_name)
+                .with_context(|| {
+                    format!(
+                        "failed to record {} in the checkout directory map",
+                        mount_point.display()
+                    )
+                })?;
+        }
+
+        // The checkout config read by CheckoutConfig::loadFromClientDirectory.
+        let config_path = client_dir.join("config.toml");
+        if !config_path.exists() {
+            fs::write(
+                &config_path,
+                format!(
+                    "[repository]\ntype = \"hg\"\npath = \"{}\"\n",
+                    repo.display()
+                ),
+            )
+            .with_context(|| format!("failed to write {}", config_path.display()))?;
+        }
+
+        // EdenFS refuses to mount a client directory that has no SNAPSHOT.
+        let snapshot_id = resolve_snapshot_id(&repo, self.rev.as_deref())?;
+        write_snapshot(&client_dir.join("SNAPSHOT"), &snapshot_id)?;
+
+        instance
+            .daemon()
+            .mount(&mount_point, &client_dir, self.read_only)
+            .await?;
+
+        println!("Mounted {}", mount_point.display());
+        Ok(0)
+    }
+}
+
+/// The commit id written into SNAPSHOT: an explicit `--rev`, otherwise the
+/// repository's current parent.
+fn resolve_snapshot_id(repo: &Path, rev: Option<&str>) -> Result<String> {
+    if let Some(rev) = rev {
+        return Ok(rev.to_owned());
+    }
+    for program in ["sl", "hg"] {
+        if let Ok(output) = Command::new(program)
+            .args(["log", "-r", ".", "-T", "{node}"])
+            .current_dir(repo)
+            .output()
+        {
+            if output.status.success() {
+                let id = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+                if !id.is_empty() {
+                    return Ok(id);
+                }
+            }
+        }
+    }
+    anyhow::bail!(
+        "unable to determine the current commit of {}; pass --rev <commit>",
+        repo.display()
+    )
+}
+
+/// Write a version-2 SNAPSHOT file: `eden` + BE u32 version + BE u32 length +
+/// the commit id as ASCII hex.
+fn write_snapshot(path: &Path, snapshot_id: &str) -> Result<()> {
+    let body = snapshot_id.as_bytes();
+    let mut data = Vec::with_capacity(12 + body.len());
+    data.extend_from_slice(b"eden\x00\x00\x00\x02");
+    data.extend_from_slice(&(body.len() as u32).to_be_bytes());
+    data.extend_from_slice(body);
+    fs::write(path, data).with_context(|| format!("failed to write {}", path.display()))
+}
